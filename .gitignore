# Terraform
.terraform/
.terraform-build/

# Re-nesting guard — never commit a clone of this repo inside itself.
# A stray `git clone ...` into the repo root previously got committed as a
# gitlink, bloating fresh clones and filling CloudShell disk (ENOSPC).
/agentic-runtime-security-on-aws-agentcore/

# GSD planning scaffolding — internal dev docs, excluded from the public samples repo
.planning/

# Vault Enterprise license — supplied per-deploy (VAULT_ENTERPRISE_LICENSE_PATH),
# never committed. Real .hclic files are commercial secrets.
*.hclic
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

