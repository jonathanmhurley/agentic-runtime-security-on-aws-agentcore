{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "stage0hello",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "stage0hello"
  },
  "runtimes": [
    {
      "name": "stage0hello",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/stage0hello/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "workshop-gateway",
      "protocolType": "None",
      "description": "Gateway for workshop-gateway",
      "targets": [],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "REPLACE_WITH_OIDC_DISCOVERY_URL",
          "allowedAudience": [
            "vault-standin"
          ],
          "allowedClients": [
            "workshop-client"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
