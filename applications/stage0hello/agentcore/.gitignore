# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
.cli/*

# Ephemeral Staging
.cache/*

# CLI-generated LLM context (type stubs + readme, regenerated by the CLI)
.llm-context/

# Exception: Commit the State
!.cli/deployed-state.json

# Deploy target carries the real account id — keep local, never publish
aws-targets.json
